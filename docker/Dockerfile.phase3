FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive

# ─────────────────────────────────────────────────────────────────────────────
# Phase 3 — Produktiv-Container
#
#   Browser ─WS─▶ noVNC/websockify (6080) ─VNC─▶ x11vnc (5900) ─grab─▶ Xvfb :99
#                                                                         ▲
#                                                                  render │
#                                                  AKC (kxgui-patched.exe) in Mono
#                                                                         │
#                                                       HTTP-Login + Init/Connect
#                                                                         ▼
#                                                                   DKX2 KVM-IP
#
# Der AKC läuft seinen normalen UI-Code-Pfad in Xvfb; x11vnc greift das Display
# ab, websockify/noVNC liefern es als Browser-Frontend. Kein Java, kein IE.
# ─────────────────────────────────────────────────────────────────────────────

RUN apt-get update && apt-get install -y --no-install-recommends \
        mono-runtime \
        libmono-system-windows-forms4.0-cil \
        libmono-system-drawing4.0-cil \
        libmono-system4.0-cil \
        libmono-system-core4.0-cil \
        libmono-system-xml4.0-cil \
        libmono-system-configuration4.0-cil \
        libmono-system-deployment4.0-cil \
        libmono-i18n4.0-all \
        libmono-cecil-cil-dev \
        libgdiplus \
        ca-certificates \
        gcc \
        libc6-dev \
        mono-mcs \
        xvfb \
        xauth \
        fluxbox \
        x11vnc \
        websockify \
        novnc \
        netcat-openbsd \
        tini \
        procps \
        x11-utils \
        x11-apps \
        xdotool \
        netpbm \
    && rm -rf /var/lib/apt/lists/*

# procps/x11-utils/x11-apps/xdotool/netpbm sind reines Debug-Werkzeug für den
# Feedback-Loop: ps, xwininfo/xdpyinfo, xdotool (Fokus/Fenster) und
# xwd|xwdtopnm|pnmtopng für Screenshots des Xvfb-Displays nach /logs/.

# ── Build-Stage: native Stubs, Cecil-Patch, Bridge.exe ──
WORKDIR /build
COPY bridge/Bridge.cs stubs/winstub.c stubs/SystemDeployment.cs stubs/CecilPatch.cs /build/
COPY bridge/app/ /opt/akc/

# 1) Native Win32-Stub-Library (urlmon/wininet/shell32/... P/Invokes)
RUN gcc -shared -fPIC -O2 -Wall -o /opt/akc/libwinstub.so /build/winstub.c

# 2) System.Deployment-Stub (fehlt in Monos Stock-DLL)
RUN mcs -target:library -out:/opt/akc/System.Deployment.dll /build/SystemDeployment.cs

# 3) Cecil-Patch: set_Icon / WebBrowser.Navigate / set_ObjectForScripting → pop;pop
#    Mono.Cecil ist nicht im GAC — DLL muss neben der exe liegen.
RUN cp /usr/lib/mono-cecil/Mono.Cecil.dll /build/ \
 && mcs -out:/build/CecilPatch.exe -r:/build/Mono.Cecil.dll /build/CecilPatch.cs \
 && mono /build/CecilPatch.exe /opt/akc/kxgui.exe /opt/akc/kxgui-patched.exe

# 4) Bridge.exe (v17: HTTP-Login + Port-Discovery + AKC-Stack + Control-API :8081)
RUN mcs -out:/opt/akc/Bridge.exe \
        -r:System.Windows.Forms.dll \
        -r:System.Drawing.dll \
        -r:/opt/akc/log4net.dll \
        /build/Bridge.cs

# ── dllmap: alle Win32-P/Invokes auf libwinstub.so umbiegen ──
RUN printf '%s\n' \
    '<configuration>' \
    '  <dllmap dll="urlmon.dll" target="libwinstub.so" />' \
    '  <dllmap dll="wininet.dll" target="libwinstub.so" />' \
    '  <dllmap dll="shell32.dll" target="libwinstub.so" />' \
    '  <dllmap dll="kernel32.dll" target="libwinstub.so" />' \
    '  <dllmap dll="kernel32" target="libwinstub.so" />' \
    '  <dllmap dll="user32.dll" target="libwinstub.so" />' \
    '  <dllmap dll="user32" target="libwinstub.so" />' \
    '  <dllmap dll="winmm.dll" target="libwinstub.so" />' \
    '  <dllmap dll="WINSCARD.DLL" target="libwinstub.so" />' \
    '  <dllmap dll="ole32.dll" target="libwinstub.so" />' \
    '</configuration>' \
    > /opt/akc/core.dll.config
RUN for d in rccore audiocore vmcore smartcard kxgui; do \
        cp /opt/akc/core.dll.config "/opt/akc/${d}.dll.config" 2>/dev/null || true; \
    done; \
    cp /opt/akc/core.dll.config /opt/akc/kxgui.exe.config; \
    cp /opt/akc/core.dll.config /opt/akc/kxgui-patched.exe.config

# fluxbox: kein Wallpaper-Setzen. Sonst ruft fbsetbg xmessage auf ("can\'t find an app
# to set the wallpaper with") — der Dialog landet mitten im Display und zieht den
# X-Input-Focus vom AKC-Fenster weg. Da fluxbox den Wallpaper-Call auch aus dem Style
# heraus absetzt, ist xmessage zusätzlich auf /bin/true umgebogen — in einem headless
# Kiosk-Container darf ohnehin kein modaler Dialog vor dem KVM-Fenster liegen.
RUN mkdir -p /root/.fluxbox \
 && printf '%s\n' 'session.screen0.rootCommand: fbsetroot -solid black' > /root/.fluxbox/init \
 && ln -sf /bin/true /usr/bin/xmessage


COPY docker/entrypoint-phase3.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /opt/akc

# ── Laufzeit-Konfiguration ──
# Ohne UTF-8-Locale schreibt Mono bzw. die JRE Umlaute im Protokoll als "?".
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV RARITAN_IP=""
ENV RARITAN_PORT=443
ENV RARITAN_USER="admin"
ENV RARITAN_PASS=""
# Optionaler Port-Override; ohne Angabe nimmt Bridge.exe die Port-Discovery.
ENV RARITAN_PORT_ID=""
ENV RARITAN_PORT_NAME=""
# Display-Geometrie und VNC-Auth
ENV SCREEN_GEOMETRY="1920x1080x24"
ENV VNC_PASSWORD=""
# KEEP_ALIVE=1: Container nach Bridge-Ende oben lassen (Debug/Feedback-Loop)
# Parameter der noVNC-Startseite; der Entrypoint baut daraus die Weiterleitung.
ENV NOVNC_OPTIONS="autoconnect=true&resize=scale&reconnect=true&reconnect_delay=2000"
ENV KEEP_ALIVE=0

#   5900 = VNC (x11vnc)   6080 = noVNC HTTP   8081 = Bridge Control-API
EXPOSE 5900 6080 8081

# Alle drei Ports, nicht nur die Anzeige: die Control-API auf 8081 oeffnet
# Bridge.exe erst nach erfolgreicher Anmeldung an der DKX2. Nur 5900/6080 zu
# pruefen meldet den Container auch dann als healthy, wenn die Bridge laengst
# abgebrochen ist und der Browser bloss auf einen schwarzen Bildschirm sieht.
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD nc -z localhost 5900 && nc -z localhost 6080 && nc -z localhost 8081 || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
