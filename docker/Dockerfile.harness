FROM debian:bookworm-slim
ENV DEBIAN_FRONTEND=noninteractive

# ─────────────────────────────────────────────────────────────────────────────
# Phase 4 — der Java-Client der KX2, ohne Browser
#
#   Browser ─WS─▶ noVNC/websockify (6080) ─VNC─▶ x11vnc (5900) ─grab─▶ Xvfb :99
#                                                                         ▲
#                                                                  render │
#                                    RcHarness → nn.pp.rc.RemoteConsoleApplet
#                                                       aus rc.jar des Geraets
#                                                                         │
#                                                                         ▼
#                                                                   DKX2 KVM-IP
#
# Der Unterschied zu Dockerfile.phase3: hier laeuft der Client, den die KX2
# selbst ausliefert, in der Applet-Umgebung, die RcHarness nachbaut. Damit
# entfaellt der gesamte Mono-Unterbau — dllmap, Cecil-Patches, XIM, Stack-Limit,
# Reflection auf den BrowserMediator.
#
# rc.jar liegt bewusst NICHT im Image: der Harness laedt sie beim Start vom
# Geraet. So passt der Client immer zur laufenden Firmware, auch nach einem
# Firmware-Update auf einem abgeschotteten System.
# ─────────────────────────────────────────────────────────────────────────────

RUN apt-get update && apt-get install -y --no-install-recommends \
        openjdk-17-jdk-headless \
        openjdk-17-jre \
        fonts-dejavu-core \
        ca-certificates \
        xvfb \
        xauth \
        fluxbox \
        x11vnc \
        websockify \
        novnc \
        netcat-openbsd \
        tini \
        procps \
        x11-utils \
        x11-apps \
        xdotool \
        netpbm \
    && rm -rf /var/lib/apt/lists/*

# openjdk-17-jre (nicht -headless) wegen Swing/AWT; das JDK nur, um den Harness
# im Image zu uebersetzen — so braucht der Zielhost keine Bauwerkzeuge.
# fonts-dejavu-core, sonst zeichnet die JRE jeden Text als Kaestchen.


RUN mkdir -p /root/.fluxbox \
 && printf '%s\n' 'session.screen0.rootCommand: fbsetroot -solid black' > /root/.fluxbox/init \
 && ln -sf /bin/true /usr/bin/xmessage


# ── Harness uebersetzen ──
WORKDIR /build
COPY harness/ /build/
# --release 17 haelt uns an die dokumentierte API; java.applet ist dort noch da,
# wenn auch als "deprecated for removal" markiert.
# JSObject: OpenJDK 17 liefert netscape.javascript zwar noch mit (Modul
# jdk.jsobject), aber OHNE die Ueberladung getWindow(java.applet.Applet) — das
# Modul kennt java.desktop gar nicht mehr. Am Geraet gemessen scheitert das
# Applet deshalb in initializeJSObjects() mit NoSuchMethodError.
#
# Loesung: jdk.jsobject aus dem Modulgraphen nehmen (--limit-modules), dann ist
# das Paket frei und unsere Fassung aus dem Klassenpfad wird geladen. java.se
# deckt alles ab, was Applet und Swing brauchen; jdk.crypto.ec bleibt fuer TLS
# ausdruecklich drin. Dieselbe Beschraenkung gilt zur Laufzeit im Entrypoint.
RUN mkdir -p classes /opt/harness \
 && javac --limit-modules java.se,jdk.crypto.ec -nowarn -encoding UTF-8 -d classes \
        netscape/javascript/JSObject.java RcHarness.java \
 && jar --create --file /opt/harness/harness.jar --main-class RcHarness -C classes . \
 && cp /build/legacy.security /opt/harness/legacy.security

COPY docker/entrypoint-harness.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

WORKDIR /opt/harness

# ── Laufzeit-Konfiguration ──
# Ohne UTF-8-Locale schreibt die JRE Umlaute im Protokoll als "?".
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV RARITAN_IP=""
ENV RARITAN_PORT=443
ENV RARITAN_USER="admin"
ENV RARITAN_PASS=""
# Leer lassen: der Harness nimmt den ersten Port, den die Geraeteseite nennt.
ENV RARITAN_PORT_ID=""
ENV SCREEN_GEOMETRY="1920x1080x24"
ENV VNC_PASSWORD=""
# Parameter der noVNC-Startseite; der Entrypoint baut daraus die Weiterleitung.
ENV NOVNC_OPTIONS="autoconnect=true&resize=scale&reconnect=true&reconnect_delay=2000"
ENV KEEP_ALIVE=0

#   5900 = VNC (x11vnc)   6080 = noVNC HTTP
EXPOSE 5900 6080

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD nc -z localhost 5900 && nc -z localhost 6080 || exit 1

ENTRYPOINT ["/usr/bin/tini", "--", "/entrypoint.sh"]
