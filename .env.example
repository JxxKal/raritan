# ── Pflicht: Zugang zur KX2 ───────────────────────────────────────────────────
# IP oder Hostname der Dominion KX2. Der Stack spricht sie ueber HTTPS an.
RARITAN_IP=10.180.42.160
RARITAN_PORT=443

# Konto auf der KX2. Es braucht Zugriff auf die KVM-Ports, die bedient werden
# sollen -- der Client uebernimmt die Rechte des angemeldeten Benutzers.
RARITAN_USER=admin
RARITAN_PASS=change-me

# ── KVM-Port ──────────────────────────────────────────────────────────────────
# Leer lassen: der Client liest die Portliste selbst vom Geraet und nimmt den
# ersten Port. Nur setzen, wenn immer derselbe kommen soll -- die Kennung hat
# die Form P_<mac>_<n> und steht im Protokoll des Containers.
RARITAN_PORT_ID=
RARITAN_PORT_NAME=
# Nur fuer den Standarddienst: die beiden Felder gehen so in den connect-Aufruf.
RARITAN_PORT_TYPE=VM
RARITAN_PORT_PERM=CCC

# 0 haelt das Passwort zurueck und laesst nur die Session zur RFB-Anmeldung zu.
# 1 gibt beides mit; der Client waehlt dann selbst, was das Geraet anbietet.
HARNESS_SEND_PASSWORD=1

# ── Anzeige ───────────────────────────────────────────────────────────────────
# Aufloesung des virtuellen Bildschirms. Sie sollte mindestens so gross sein wie
# die des Zielrechners, sonst skaliert der Client herunter.
SCREEN_GEOMETRY=1920x1080x24

# Parameter, mit denen die Startseite auf vnc.html weiterleitet. Vorgabe:
# sofort verbinden, ins Browserfenster skalieren, nach Abbruch neu verbinden.
# Leeren, wenn stattdessen die Schaltflaeche "Verbinden" erscheinen soll.
NOVNC_OPTIONS=autoconnect=true&resize=scale&reconnect=true&reconnect_delay=2000

# Passwort fuer den VNC-Zugang. Leer bedeutet: KEINE Authentisierung -- dann
# darf der VNC-Port nicht offen im Netz stehen. Siehe DEPLOYMENT.md Abschnitt 4.
VNC_PASSWORD=

# ── Ports auf dem Host ────────────────────────────────────────────────────────
# Standarddienst raritan-kvm. Die Angaben duerfen eine Adresse enthalten, dann
# lauscht Docker nur dort -- etwa NOVNC_HOST_PORT=127.0.0.1:6080.
VNC_HOST_PORT=5900
NOVNC_HOST_PORT=6080

# Nur fuer "--profile akc": eigene Ports, damit beide Wege nebeneinander laufen
# koennen. CTRL_HOST_PORT ist die Control-API der Bridge; der Standarddienst
# hat keine.
VNC_HOST_PORT_AKC=5901
NOVNC_HOST_PORT_AKC=6081
CTRL_HOST_PORT=8081

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Nur ausfuellen, wenn der Host beim BAUEN nicht direkt ins Netz kommt (apt).
# Leer bedeutet: kein Proxy.
#   HTTP_PROXY=http://proxy.example.org:3128
#
# Zur Laufzeit wird bewusst KEIN Proxy verwendet: der Container spricht nur mit
# der KX2 im lokalen Netz. Der Stack setzt dafuer no_proxy=* im Container --
# nicht aendern, sonst laeuft der Login der KX2 in den Proxy. Warum eine
# einzelne IP dort nicht genuegt, steht in DEPLOYMENT.md Abschnitt 2.
#
# Das Basis-Image (debian:bookworm-slim) zieht der Docker-DAEMON, nicht der
# Build -- fuer den ist der Proxy getrennt zu hinterlegen, siehe DEPLOYMENT.md.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1

# ── Betrieb ───────────────────────────────────────────────────────────────────
RESTART_POLICY=unless-stopped

# 1 = Container bleibt oben, wenn der Client abbricht. Xvfb, x11vnc und noVNC
# laufen weiter, der Zustand laesst sich in Ruhe ansehen. Nur zur Fehlersuche.
KEEP_ALIVE=0

# ── Eigenes Subnetz (optional) ────────────────────────────────────────────────
# Nur noetig, wenn Docker beim Start meldet:
#   all predefined address pools have been fully subnetted
#
# Beide Zeilen einkommentieren. COMPOSE_FILE sorgt dafuer, dass jeder
# docker-compose-Befehl die Override-Datei mitnimmt -- ohne sie wuerde ein
# spaeteres "docker compose up -d" das Netz wieder aus dem Pool anlegen.
#
# Der Bereich darf sich weder mit dem OT-Netz noch mit einem anderen
# Docker-Netz auf dem Host ueberschneiden. Belegte Bereiche zeigt:
#   docker network inspect $(docker network ls -q) \
#       --format '{{.Name}} {{range .IPAM.Config}}{{.Subnet}}{{end}}'
#RARITAN_SUBNET=172.31.251.0/24
#COMPOSE_FILE=docker-compose.yml:docker-compose.subnet.yml
